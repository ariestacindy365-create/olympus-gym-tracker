// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  COACH
  MEMBER
  ADMIN
  OWNER
}

// Which cartoon lifter appears on the member's shareable story cards —
// picked by the member themselves (the app stores no gender/hijab data).
enum StoryCharacter {
  PRIA
  WANITA
  HIJAB
}

// Skin colour of that lifter, also the member's own pick.
enum StorySkinTone {
  TERANG
  LANGSAT
  SAWO
  GELAP
}

enum PRType {
  MAX_WEIGHT
  MAX_1RM
  // Longest / most for timed, lap, distance and calorie sets without load.
  MAX_AMOUNT
}

// What a set's number counts: reps, or seconds / laps / meters / calories
// for movements done for time or distance (plank 30", 1 lap, 7 kal).
enum SetUnit {
  REPS
  SECONDS
  LAPS
  METERS
  CALORIES
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  pinHash      String
  role         Role
  lastActiveAt DateTime  @default(now())
  presentDate  DateTime?
  // Null until the member picks one; the story card asks on first use.
  storyCharacter StoryCharacter?
  storySkinTone  StorySkinTone?
  // Members can hide themselves from the monthly leaderboard.
  leaderboardOptOut Boolean @default(false)
  // Default "Dilihat oleh" for workouts the member saves to the feed.
  feedVisibility WorkoutVisibility @default(ALL)
  // Morning "program hari ini" reminder.
  notifyProgram  Boolean           @default(true)
  // Evening "jangan lupa catat" reminder when nothing was logged today.
  notifyReminder Boolean           @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  personalTraining     CoachPersonalProgram?
  setEntries           SetEntry[]
  personalRecords      PersonalRecord[]
  bodyMetrics          BodyMetric[]
  dailyWorkoutsCreated DailyWorkout[]      @relation("CoachDailyWorkouts")
  programsAsCoach      TrainingProgram[]   @relation("CoachPrograms")
  classSlots           ClassSlot[]         @relation("CoachClassSlots")
  notifications        Notification[]
  announcements        Announcement[]
  pushSubscriptions    PushSubscription[]
  programSnapshots     ProgramSnapshot[]   @relation("CoachProgramSnapshots")
  programWeekOverrides ProgramWeekOverride[] @relation("CoachProgramWeekOverrides")
  achievementUnlocks   AchievementUnlock[]
  coachNotesReceived   CoachNote[]         @relation("MemberCoachNotes")
  coachNotesWritten    CoachNote[]         @relation("CoachNotesWritten")
  workouts             Workout[]
  workoutKudos         WorkoutKudo[]
  workoutComments      WorkoutComment[]

  // CRM (lead capture / follow-up) — used by ADMIN and OWNER roles only.
  capturedLeads      Lead[]     @relation("CapturedLeads")
  completedFollowUps FollowUp[] @relation("CompletedFollowUps")
  deletedLeads       Lead[]     @relation("DeletedLeads")
  target             Target?    @relation("AdminTarget")
  paymentsRecorded   Payment[]  @relation("PaymentsRecorded")
  paymentsDeleted    Payment[]  @relation("PaymentsDeleted")
  expensesRecorded   Expense[]  @relation("ExpensesRecorded")
  salesRecorded      Sale[]     @relation("SalesRecorded")
  salesDeleted       Sale[]     @relation("SalesDeleted")
  restocksRecorded   Restock[]  @relation("RestocksRecorded")
  stockAdjustmentsRecorded StockAdjustment[] @relation("StockAdjustmentsRecorded")
}

// Achievement definitions live in code (src/lib/achievements.ts), not the
// DB — this table only records which member unlocked which achievement
// code and when, so the catalog can grow without a migration each time.
model AchievementUnlock {
  id              String    @id @default(cuid())
  memberId        String
  member          User      @relation(fields: [memberId], references: [id])
  achievementCode String
  unlockedAt      DateTime  @default(now())
  // Null until the member has been shown the celebration for it. Set
  // immediately for member-initiated unlocks (they see the modal right
  // away); left null for coach-initiated ones so the member gets notified
  // next time they open the app instead of never finding out.
  seenAt          DateTime?

  @@unique([memberId, achievementCode])
  @@index([memberId])
}

model Exercise {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  dailyWorkouts   DailyWorkout[]
  setEntries      SetEntry[]
  personalRecords PersonalRecord[]
}

// One broadcast per calendar day, visible to every member.
model DailyWorkout {
  id          String   @id @default(cuid())
  workoutDate DateTime
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
  coachId     String
  coach       User     @relation("CoachDailyWorkouts", fields: [coachId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([workoutDate])
}

// One of a member's sets for one exercise on one day. Re-saving the same
// exercise+day+setNumber upserts (overwrites) rather than creating a new row.
model SetEntry {
  id           String   @id @default(cuid())
  memberId     String
  member       User     @relation(fields: [memberId], references: [id])
  exerciseId   String
  exercise     Exercise @relation(fields: [exerciseId], references: [id])
  workoutDate  DateTime
  setNumber    Int
  weight       Float
  // The amount, in `unit` (reps unless it's a timed / lap / distance set).
  reps         Int
  unit         SetUnit  @default(REPS)
  // One side at a time ("10 reps each"): reps are per side, volume counts both.
  perSide      Boolean  @default(false)
  estimated1RM Float
  note         String?
  isPR         Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([memberId, exerciseId, workoutDate, setNumber])
  @@index([workoutDate])
}

// One weigh-in per member per day — weight, body fat %, and skeletal muscle
// mass together, since a smart scale reads all three at once. Re-saving the
// same day upserts rather than creating a new row.
model BodyMetric {
  id                 String   @id @default(cuid())
  memberId           String
  member             User     @relation(fields: [memberId], references: [id])
  recordedDate       DateTime
  weight             Float
  bodyFatPercent     Float?
  // InBody-era reading (kg). The gym now uses an Omron Karada Scan, which
  // reports skeletal muscle as a percentage instead — kept for history.
  skeletalMuscleMass Float?
  visceralFat        Float?
  // Omron Karada Scan readings.
  skeletalMusclePercent Float?
  bodyAge               Float?
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([memberId, recordedDate])
  @@index([recordedDate])
}

model PersonalRecord {
  id           String   @id @default(cuid())
  memberId     String
  member       User     @relation(fields: [memberId], references: [id])
  exerciseId   String
  exercise     Exercise @relation(fields: [exerciseId], references: [id])
  type         PRType
  weight       Float
  reps         Int
  // Unit of the record set (MAX_AMOUNT records are seconds / laps / …).
  unit         SetUnit  @default(REPS)
  estimated1RM Float
  setEntryId   String
  achievedAt   DateTime @default(now())

  @@unique([memberId, exerciseId, type])
}

// Master exercise dictionary for building training programs (coach-only).
// Deliberately separate from Exercise (which members pick from when logging
// sets) so the much larger movement library doesn't bloat that dropdown.
model Movement {
  id              String   @id @default(cuid())
  code            String?
  name            String   @unique
  primaryMuscle   String?
  secondaryMuscle String?
  category        String?
  equipment       String?
  repRangeHint    String?
  setRangeHint    String?
  createdAt       DateTime @default(now())

  slots ProgramSlot[]
}

// A coach's weekly bootcamp-class program (Minggu 1-4). Each coach has
// their own; members see the program of the coach teaching their class
// (see ClassSlot). One row per coach + week, kept unique in code.
model TrainingProgram {
  id         String   @id @default(cuid())
  weekNumber Int
  coachId    String
  coach      User     @relation("CoachPrograms", fields: [coachId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  days ProgramDay[]

  @@index([coachId, weekNumber])
}

// The class timetable: who teaches each class time (lib/classSessions) on
// each weekday. weekday follows Date.getDay(): 1 = Senin … 6 = Sabtu.
model ClassSlot {
  weekday   Int
  sessionId String
  coachId   String?
  coach     User?    @relation("CoachClassSlots", fields: [coachId], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt

  @@id([weekday, sessionId])
}

model ProgramDay {
  id         String          @id @default(cuid())
  programId  String
  program    TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  dayLabel   String
  focusLabel String?
  order      Int

  slots ProgramSlot[]

  @@unique([programId, order])
}

model ProgramSlot {
  id           String     @id @default(cuid())
  dayId        String
  day          ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  slotLabel    String?
  movementId   String
  movement     Movement   @relation(fields: [movementId], references: [id])
  sets         Int?
  repTarget    String?
  targetWeight Float?
  note         String?
  // Shared training scheme for the round this slot belongs to (e.g. "E3MOM",
  // "Team of 2", "AMRAP") — a round is every slot whose slotLabel shares the
  // same leading letter ("A1"/"A2" = one round). Only meaningful on the
  // round's first slot; only that value is read when rendering.
  roundScheme  String?
  order        Int

  @@index([dayId])
}

// Immutable snapshot of a week's full program, recorded automatically every
// time a coach saves Minggu 1-4 — since the live TrainingProgram/ProgramDay
// rows are fully deleted and recreated on each save, this is the only record
// of what a program looked like at a past point in time. Movement names are
// baked into `data` (denormalized) so old snapshots stay readable even if a
// Movement is later renamed or removed. Kept as an edit-history audit trail,
// separate from ProgramRotation below (which powers the "what applies on
// date X" calendar).
model ProgramSnapshot {
  id         String   @id @default(cuid())
  weekNumber Int
  coachId    String
  coach      User     @relation("CoachProgramSnapshots", fields: [coachId], references: [id])
  data       Json
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Anchors the Minggu 1-4 rotation to real calendar weeks so the history
// calendar can compute which week (1-4) applies to any date — e.g. "the
// week starting 17 Aug 2026 is Minggu 2" — cycling forever from that one
// point (not based on when a coach happens to edit/save a week). Singleton:
// always exactly one row, id fixed to "singleton".
model ProgramRotation {
  id               String   @id @default("singleton")
  anchorMonday     DateTime
  anchorWeekNumber Int
  updatedAt        DateTime @updatedAt
}

// One-off exception to the rotation: "the week starting this Monday runs
// Minggu N instead". Only that week changes — the rotation keeps cycling
// from its anchor, so the week after is back on schedule.
model ProgramWeekOverride {
  weekStart  DateTime @id
  weekNumber Int
  coachId    String
  coach      User     @relation("CoachProgramWeekOverrides", fields: [coachId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// --- CRM: WA lead capture & follow-up (ADMIN/OWNER only) -------------------

// The funnel stage an admin moves a lead through by hand. Trial booking
// itself happens in the separate Fitquarter app — this only tracks status.
enum LeadStatus {
  DM
  TRIAL
  MEMBER
  RETENSI
  LOST
}

// Where a lead first heard of the gym — picked at capture, drives the
// owner's "konversi per sumber" breakdown. Null for leads captured before
// this existed (shown as "Belum diisi").
enum LeadSource {
  INSTAGRAM
  TIKTOK
  FACEBOOK
  WALK_IN
  REFERRAL
  LAINNYA
}

// A prospective client who DM'd after seeing an ad.
model Lead {
  id                 String     @id @default(cuid())
  waNumber           String
  // Digits-only, 62-prefixed form of waNumber (see lib/whatsapp.ts). Used to
  // catch duplicate captures regardless of how the number was typed
  // (0812... vs 62812... vs with spaces/dashes) — enforced in the API layer
  // rather than a DB unique constraint so a soft-deleted lead's old number
  // can be re-captured later.
  waNumberNormalized String     @default("")
  name               String
  status             LeadStatus @default(DM)
  source             LeadSource?
  replyCount         Int        @default(0)
  // Set when status is marked TRIAL (booking itself happens in Fitquarter).
  // Base date for the auto-generated H+1/H+3 follow-ups below.
  trialMarkedAt      DateTime?
  // Set the moment status first becomes MEMBER — the timestamp the
  // conversion-rate chart buckets by (updatedAt isn't reliable for this
  // since any field edit bumps it, not just a status change).
  convertedAt        DateTime?
  // Soft delete — "Hapus" sets these instead of removing the row, so the
  // deletion still shows up in the Riwayat history.
  deletedAt          DateTime?
  deletedById        String?
  deletedBy          User?      @relation("DeletedLeads", fields: [deletedById], references: [id])
  capturedById       String
  capturedBy         User       @relation("CapturedLeads", fields: [capturedById], references: [id])
  capturedAt         DateTime   @default(now())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  followUps FollowUp[]
  payments  Payment[]

  @@index([capturedAt])
  @@index([status])
  @@index([capturedById])
  @@index([waNumberNormalized])
}

enum FollowUpType {
  H1
  H3
  H7
  H21
  // Admin-scheduled for an arbitrary date — e.g. the lead asked to be
  // followed up again next week/month. See /api/leads/[leadId]/followups.
  CUSTOM
}

enum FollowUpStatus {
  PENDING
  DONE
  MISSED
}

// Auto-generated from two events: H1/H3 (trialMarkedAt+1/+3) the moment a
// lead's status is set to TRIAL, and H7/H21 (convertedAt+7/+21) the moment
// it's set to MEMBER — a check-in + Google review ask at one week, and a
// check-in + membership-expiring reminder at three weeks. dueDate uses the
// same local-midnight convention as DailyWorkout.workoutDate so "due today"
// is a plain equality check.
model FollowUp {
  id            String         @id @default(cuid())
  leadId        String
  lead          Lead           @relation(fields: [leadId], references: [id])
  type          FollowUpType
  dueDate       DateTime
  status        FollowUpStatus @default(PENDING)
  completedAt   DateTime?
  completedById String?
  completedBy   User?          @relation("CompletedFollowUps", fields: [completedById], references: [id])
  note          String?
  createdAt     DateTime       @default(now())

  @@index([leadId])
  @@index([dueDate])
}

// Daily capture/follow-up milestone the OWNER sets per ADMIN. One row per
// admin — it's a standing target that applies every day until changed, not
// a per-date record.
model Target {
  id             String   @id @default(cuid())
  adminId        String   @unique
  admin          User     @relation("AdminTarget", fields: [adminId], references: [id])
  targetCapture  Int      @default(5)
  targetFollowup Int      @default(10)
  updatedAt      DateTime @updatedAt
}

enum PaymentMethod {
  QRIS
  TRANSFER
  KARTU_KREDIT
  DEBIT
  FITQUARTER
  TUNAI
}

// A payment an admin records for a member — initial or renewal — printable
// as a receipt at /leads/[leadId]/receipt/[paymentId]. amount is in whole
// Rupiah (no decimals).
model Payment {
  id               String        @id @default(cuid())
  leadId           String
  lead             Lead          @relation(fields: [leadId], references: [id])
  packageName      String
  amount           Int
  paymentMethod    PaymentMethod @default(TRANSFER)
  paidAt           DateTime      @default(now())
  // Snapshot of the package's duration at time of payment (like packageName/
  // amount) — null when the package's duration wasn't known (e.g. a custom
  // package typed in free-form). Drives expiresAt below and the renewal
  // reminder; a later edit to Package.durationDays never changes past receipts.
  durationDays     Int?
  // paidAt + durationDays, computed once at creation. Null when durationDays
  // is null. Used to schedule an accurate renewal-reminder follow-up instead
  // of a fixed offset from the member's original conversion date.
  expiresAt        DateTime?
  // Bukti transfer/pembayaran, uploaded from camera or gallery, resized
  // client-side then uploaded server-side to a Google Drive folder (see
  // lib/googleDrive.ts) — this is that file's Drive file ID, not the image
  // itself. Null when skipped. Viewed via /api/payments/[paymentId]/proof,
  // which proxies it through the app's own Drive access so the Drive file
  // itself never has to be made public.
  proofImageFileId String?
  note             String?
  createdById      String
  createdBy        User          @relation("PaymentsRecorded", fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())
  // Soft delete, same reasoning as Lead — keeps the row (and its receipt)
  // so a correction shows up as an audit trail on Riwayat for OWNER to see,
  // instead of the payment silently vanishing from the numbers.
  deletedAt        DateTime?
  deletedById      String?
  deletedBy        User?         @relation("PaymentsDeleted", fields: [deletedById], references: [id])

  @@index([leadId])
}

enum ExpenseCategory {
  SEWA
  GAJI
  LISTRIK_AIR
  ALAT
  MARKETING
  MAINTENANCE
  LAINNYA
}

// A business expense — rent, salaries, equipment, etc. — logged by ADMIN
// day-to-day (same as Payment); OWNER sees the aggregated reporting on
// the dashboard instead of recording expenses directly.
model Expense {
  id               String          @id @default(cuid())
  category         ExpenseCategory
  amount           Int
  description      String?
  paidAt           DateTime        @default(now())
  // Same Drive-upload scheme as Payment.proofImageFileId — a receipt/nota
  // photo, optional.
  proofImageFileId String?
  createdById      String
  createdBy        User            @relation("ExpensesRecorded", fields: [createdById], references: [id])
  createdAt        DateTime        @default(now())

  @@index([paidAt])
}

// Master price list, managed by OWNER at /leads/packages. Payment.packageName
// is a plain string snapshot (not a foreign key here) so editing or
// deactivating a package never changes what a past receipt shows.
model Package {
  id           String   @id @default(cuid())
  name         String
  price        Int
  // How long this package lasts once paid for — drives Payment.expiresAt and
  // the renewal-reminder follow-up. Optional: some packages (or ad-hoc ones
  // typed at payment time) may not have a fixed duration.
  durationDays Int?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
}

// Food & drink catalog for the front-desk "Kasir" — separate from Package
// (memberships) since this has its own barcode + stock, managed by OWNER at
// /leads/products.
model Product {
  id                String   @id @default(cuid())
  name              String
  barcode           String   @unique
  price             Int
  stock             Int      @default(0)
  // Below this, the product shows up in the "Stok Menipis" warning (Kasir
  // dashboard + daily report). Per-product since sales pace varies a lot
  // between items.
  lowStockThreshold Int      @default(5)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sales            Sale[]
  restocks         Restock[]
  stockAdjustments StockAdjustment[]

  @@index([isActive])
}

// Stock changes that aren't a sale or a restock: the starting stock of a
// new product, and an admin overwriting the number in Kelola Produk (e.g.
// after a stock count). Together with Sale and Restock this gives the full
// "stok masuk / keluar" history on the Kasir Riwayat tab.
enum StockAdjustmentReason {
  INITIAL
  EDIT
}

model StockAdjustment {
  id          String                @id @default(cuid())
  productId   String
  product     Product               @relation(fields: [productId], references: [id])
  reason      StockAdjustmentReason
  change      Int
  stockBefore Int
  stockAfter  Int
  createdById String
  createdBy   User                  @relation("StockAdjustmentsRecorded", fields: [createdById], references: [id])
  createdAt   DateTime              @default(now())

  @@index([productId])
  @@index([createdAt])
}

// A manual stock top-up, logged separately from just editing the stock
// number directly — keeps a "who added how much, when" trail instead of an
// opaque overwrite. stockBefore/stockAfter are snapshotted at restock time
// (not derived by subtracting quantity from the product's *current* stock),
// so the trail stays accurate even after later sales/restocks move the
// product's stock further.
model Restock {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  stockBefore Int
  stockAfter  Int
  createdById String
  createdBy   User     @relation("RestocksRecorded", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([productId])
}

// One scanned sale (quantity always 1 — scan again to sell another unit).
// productName/price are snapshots, like Payment.packageName/amount, so
// renaming or repricing a Product later doesn't change past sales.
model Sale {
  id            String        @id @default(cuid())
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  productName   String
  price         Int
  paymentMethod PaymentMethod @default(TUNAI)
  // Optional free-text note, e.g. who it's for ("bos", "tamu") — same idea
  // as Payment.note.
  note          String?
  createdById   String
  createdBy     User          @relation("SalesRecorded", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  // Soft delete, same reasoning as Payment — corrects a mistake (e.g. a
  // double scan) without erasing the record, and restores the product's
  // stock by 1 when deleted. Shows up as an audit trail on Riwayat.
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?         @relation("SalesDeleted", fields: [deletedById], references: [id])

  @@index([productId])
  @@index([createdAt])
}

// Feedback a coach leaves for a member (form cues, progress notes). context
// is a free-text snapshot of what it's about, e.g. "Back Squat · 12 Okt",
// so the note still reads right if the set is later edited or deleted.
model CoachNote {
  id        String    @id @default(cuid())
  memberId  String
  member    User      @relation("MemberCoachNotes", fields: [memberId], references: [id])
  coachId   String
  coach     User      @relation("CoachNotesWritten", fields: [coachId], references: [id])
  context   String?
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([memberId, createdAt])
}

enum WorkoutVisibility {
  ALL
  COACH
  PRIVATE
}

// A finished training day ("Selesai latihan hari ini"), shown on the member
// feed. The sets themselves stay in SetEntry; this records the wrap-up
// (title, duration, note, who can see it) and snapshots the day's totals so
// the feed doesn't recompute them. One per member per day: finishing again
// updates it.
model Workout {
  id          String            @id @default(cuid())
  memberId    String
  member      User              @relation(fields: [memberId], references: [id])
  workoutDate DateTime
  title       String
  note        String?
  durationSec Int
  totalVolume Float
  totalSets   Int
  prCount     Int
  visibility  WorkoutVisibility @default(ALL)
  // e.g. "Coach Ari · 09:00", the class the member followed.
  classLabel  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  kudos    WorkoutKudo[]
  comments WorkoutComment[]

  @@unique([memberId, workoutDate])
  @@index([createdAt])
}

model WorkoutKudo {
  workoutId String
  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  memberId  String
  member    User     @relation(fields: [memberId], references: [id])
  createdAt DateTime @default(now())

  @@id([workoutId, memberId])
}

model WorkoutComment {
  id        String   @id @default(cuid())
  workoutId String
  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  memberId  String
  member    User     @relation(fields: [memberId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([workoutId, createdAt])
}

// --- Notifications ------------------------------------------------------------

enum NotificationType {
  KUDOS
  COMMENT
  COACH_NOTE
  PROGRAM_TODAY
  ANNOUNCEMENT
  LOG_REMINDER
}

// One in-app notification for one user (also sent to their phone when they
// turned push on).
model Notification {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String
  body           String
  url            String?
  announcementId String?
  announcement   Announcement?    @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([userId, createdAt])
}

enum AnnouncementCategory {
  PENGUMUMAN
  PROMO
  ARTIKEL
  LAINNYA
}

// Sent by staff to every member; each member gets a Notification row.
model Announcement {
  id          String               @id @default(cuid())
  category    AnnouncementCategory
  title       String
  body        String
  linkUrl     String?
  createdById String
  createdBy   User                 @relation(fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())

  notifications Notification[]

  @@index([createdAt])
}

// A browser/phone that accepted push notifications.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// The app's VAPID key pair for Web Push, made on first use. Singleton.
model PushConfig {
  id         String   @id @default("singleton")
  publicKey  String
  privateJwk Json
  createdAt  DateTime @default(now())
}

// Private template for the coach's own workouts, separate from class programs.
model CoachPersonalProgram {
  coachId   String   @id
  coach     User     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  days      Json
  updatedAt DateTime @updatedAt
}
