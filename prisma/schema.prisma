// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  COACH
  MEMBER
  ADMIN
  OWNER
}

enum PRType {
  MAX_WEIGHT
  MAX_1RM
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  pinHash      String
  role         Role
  lastActiveAt DateTime  @default(now())
  presentDate  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime @updatedAt

  setEntries           SetEntry[]
  personalRecords      PersonalRecord[]
  bodyMetrics          BodyMetric[]
  dailyWorkoutsCreated DailyWorkout[]      @relation("CoachDailyWorkouts")
  programsAsCoach      TrainingProgram[]   @relation("CoachPrograms")
  achievementUnlocks   AchievementUnlock[]

  // CRM (lead capture / follow-up) — used by ADMIN and OWNER roles only.
  capturedLeads       Lead[]     @relation("CapturedLeads")
  completedFollowUps  FollowUp[] @relation("CompletedFollowUps")
  target              Target?    @relation("AdminTarget")
}

// Achievement definitions live in code (src/lib/achievements.ts), not the
// DB — this table only records which member unlocked which achievement
// code and when, so the catalog can grow without a migration each time.
model AchievementUnlock {
  id              String    @id @default(cuid())
  memberId        String
  member          User      @relation(fields: [memberId], references: [id])
  achievementCode String
  unlockedAt      DateTime  @default(now())
  // Null until the member has been shown the celebration for it. Set
  // immediately for member-initiated unlocks (they see the modal right
  // away); left null for coach-initiated ones so the member gets notified
  // next time they open the app instead of never finding out.
  seenAt          DateTime?

  @@unique([memberId, achievementCode])
  @@index([memberId])
}

model Exercise {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  dailyWorkouts   DailyWorkout[]
  setEntries      SetEntry[]
  personalRecords PersonalRecord[]
}

// One broadcast per calendar day, visible to every member.
model DailyWorkout {
  id          String   @id @default(cuid())
  workoutDate DateTime
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
  coachId     String
  coach       User     @relation("CoachDailyWorkouts", fields: [coachId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([workoutDate])
}

// One of a member's sets for one exercise on one day. Re-saving the same
// exercise+day+setNumber upserts (overwrites) rather than creating a new row.
model SetEntry {
  id           String   @id @default(cuid())
  memberId     String
  member       User     @relation(fields: [memberId], references: [id])
  exerciseId   String
  exercise     Exercise @relation(fields: [exerciseId], references: [id])
  workoutDate  DateTime
  setNumber    Int
  weight       Float
  reps         Int
  estimated1RM Float
  note         String?
  isPR         Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([memberId, exerciseId, workoutDate, setNumber])
  @@index([workoutDate])
}

// One weigh-in per member per day — weight, body fat %, and skeletal muscle
// mass together, since a smart scale reads all three at once. Re-saving the
// same day upserts rather than creating a new row.
model BodyMetric {
  id                 String   @id @default(cuid())
  memberId           String
  member             User     @relation(fields: [memberId], references: [id])
  recordedDate       DateTime
  weight             Float
  bodyFatPercent     Float?
  skeletalMuscleMass Float?
  visceralFat        Float?
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([memberId, recordedDate])
  @@index([recordedDate])
}

model PersonalRecord {
  id           String   @id @default(cuid())
  memberId     String
  member       User     @relation(fields: [memberId], references: [id])
  exerciseId   String
  exercise     Exercise @relation(fields: [exerciseId], references: [id])
  type         PRType
  weight       Float
  reps         Int
  estimated1RM Float
  setEntryId   String
  achievedAt   DateTime @default(now())

  @@unique([memberId, exerciseId, type])
}

// Master exercise dictionary for building training programs (coach-only).
// Deliberately separate from Exercise (which members pick from when logging
// sets) so the much larger movement library doesn't bloat that dropdown.
model Movement {
  id              String   @id @default(cuid())
  code            String?
  name            String   @unique
  primaryMuscle   String?
  secondaryMuscle String?
  category        String?
  equipment       String?
  repRangeHint    String?
  setRangeHint    String?
  createdAt       DateTime @default(now())

  slots ProgramSlot[]
}

// A single shared weekly bootcamp-class program, visible to every coach —
// not tied to an individual member.
model TrainingProgram {
  id         String   @id @default(cuid())
  weekNumber Int      @unique
  coachId    String
  coach      User     @relation("CoachPrograms", fields: [coachId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  days ProgramDay[]
}

model ProgramDay {
  id         String          @id @default(cuid())
  programId  String
  program    TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  dayLabel   String
  focusLabel String?
  order      Int

  slots ProgramSlot[]

  @@unique([programId, order])
}

model ProgramSlot {
  id           String     @id @default(cuid())
  dayId        String
  day          ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  slotLabel    String?
  movementId   String
  movement     Movement   @relation(fields: [movementId], references: [id])
  sets         Int?
  repTarget    String?
  targetWeight Float?
  note         String?
  order        Int

  @@index([dayId])
}

// --- CRM: WA lead capture & follow-up (ADMIN/OWNER only) -------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  TRIAL
  CONVERTED
  LOST
}

// A prospective client who DM'd after seeing an ad. replyCount tracks how
// many times they've replied to the admin's DM; 2+ replies = "qualified"
// (lib/leads.ts owns that threshold so it isn't duplicated across routes).
model Lead {
  id           String     @id @default(cuid())
  waNumber     String
  name         String
  status       LeadStatus @default(NEW)
  replyCount   Int        @default(0)
  capturedById String
  capturedBy   User       @relation("CapturedLeads", fields: [capturedById], references: [id])
  capturedAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  trials    Trial[]
  followUps FollowUp[]

  @@index([capturedAt])
  @@index([status])
  @@index([capturedById])
}

// A trial offered to a lead. converted stays null until the admin records an
// outcome; discountGiven is set automatically when convertedAt falls on the
// same calendar day as endDate (same-day conversion incentive).
model Trial {
  id            String    @id @default(cuid())
  leadId        String
  lead          Lead      @relation(fields: [leadId], references: [id])
  offeredAt     DateTime  @default(now())
  startDate     DateTime
  endDate       DateTime
  converted     Boolean?
  convertedAt   DateTime?
  discountGiven Boolean   @default(false)
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  followUps FollowUp[]

  @@index([leadId])
}

enum FollowUpType {
  H1
  H3
}

enum FollowUpStatus {
  PENDING
  DONE
  MISSED
}

// Auto-generated (H1 = endDate+1, H3 = endDate+3) when a trial ends without
// same-day conversion. dueDate uses the same local-midnight convention as
// DailyWorkout.workoutDate so "due today" is a plain equality check.
model FollowUp {
  id            String         @id @default(cuid())
  leadId        String
  lead          Lead           @relation(fields: [leadId], references: [id])
  trialId       String?
  trial         Trial?         @relation(fields: [trialId], references: [id])
  type          FollowUpType
  dueDate       DateTime
  status        FollowUpStatus @default(PENDING)
  completedAt   DateTime?
  completedById String?
  completedBy   User?          @relation("CompletedFollowUps", fields: [completedById], references: [id])
  note          String?
  createdAt     DateTime       @default(now())

  @@index([leadId])
  @@index([dueDate])
}

// Daily capture/follow-up milestone the OWNER sets per ADMIN. One row per
// admin — it's a standing target that applies every day until changed, not
// a per-date record.
model Target {
  id             String   @id @default(cuid())
  adminId        String   @unique
  admin          User     @relation("AdminTarget", fields: [adminId], references: [id])
  targetCapture  Int      @default(5)
  targetFollowup Int      @default(10)
  updatedAt      DateTime @updatedAt
}
